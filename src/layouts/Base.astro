---
interface Props {
  title: string;
  description: string;
  /**
   * The page search engines should index for this content. The classic page points to
   * the home page, which carries the same text (the 3D panels): one page, not duplicates.
   */
  canonical?: string;
}

const { title, description, canonical = '/' } = Astro.props;
const buildSha = import.meta.env.PUBLIC_BUILD_SHA ?? 'dev';
const site = Astro.site ?? new URL('https://portfolio.calixteair.fr');
const url = new URL(canonical, site).href;
const image = new URL('/og.jpg', site).href;
const PROFILES = ['https://github.com/Calixteair', 'https://www.linkedin.com/in/calixte-reymond/'];
// Structured data: who this portfolio is about (schema.org Person), for search engines.
const person = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Calixte Reymond',
  jobTitle: 'Étudiant ingénieur en cybersécurité',
  url: site.href,
  sameAs: PROFILES,
});
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <meta name="x-build" content={buildSha} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={url} />
    <title>{title}</title>
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Calixte Reymond" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Le pendentif d'acier chauffé à blanc dans la forge" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" is:inline set:html={person} />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --forge-void: #050302;
    --ink: #e8e2dc;
  }

  html,
  body {
    margin: 0;
    height: 100%;
    background: var(--forge-void);
    color: var(--ink);
  }
</style>
