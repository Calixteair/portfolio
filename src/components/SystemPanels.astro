---
/**
 * Detail panels of the planetary system (SPEC §5.7), rendered statically: one article per
 * body, hidden until the island opens it after the travel. Readable, accessible, indexable
 * HTML, the same articles as the classic page (EntryArticle). Plus the keyboard list that
 * drives the same navigation as the clicks.
 */
import EntryArticle from './EntryArticle.astro';
import { loadSections } from '../content/sections';

const sections = await loadSections();
---

<section id="system-ui" class="system-ui" aria-label="Système planétaire du portfolio" hidden>
  <nav class="system-nav" aria-label="Aller vers un astre">
    {sections.groups.map((g) => (
      <div class="system-nav-group">
        <h2>{g.title}</h2>
        <ul>
          {g.items.map((e) => (
            <li>
              <a href={`#${e.id}`} data-body={e.id}>
                {e.data.title}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </nav>
  <a class="system-classic" href="/classique/">
    Version classique
  </a>

  {sections.entries.map((e) => (
    <EntryArticle entry={e} sections={sections} variant="panel" />
  ))}
</section>

<style>
  .system-ui {
    position: fixed;
    inset: 0;
    z-index: 6;
    pointer-events: none;
    color: var(--ink);
    font:
      400 0.95rem/1.55 system-ui,
      sans-serif;
  }

  /* Keyboard list: visually hidden until it receives focus (skip-link pattern). */
  .system-nav {
    position: absolute;
    left: 1rem;
    top: 1rem;
    max-height: calc(100% - 2rem);
    overflow: auto;
    padding: 0.75rem 1rem;
    background: rgb(2 4 12 / 0.85);
    border-left: 2px solid #2f6bff;
    clip-path: inset(50%);
    pointer-events: auto;
  }
  .system-nav:focus-within {
    clip-path: none;
  }
  .system-nav h2 {
    margin: 0.5rem 0 0.25rem;
    font-size: 0.8rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    opacity: 0.7;
  }
  .system-nav ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .system-nav a {
    color: inherit;
  }
  .system-classic {
    position: absolute;
    left: 1.25rem;
    bottom: 1rem;
    font-size: 0.85rem;
    color: var(--ink);
    opacity: 0.6;
    pointer-events: auto;
  }
  .system-classic:hover,
  .system-classic:focus-visible {
    opacity: 1;
  }
</style>
