---
/**
 * Detail panels of the planetary system (SPEC §5.7), rendered statically: one article per
 * body, hidden until the island opens it after the travel. Readable, accessible, indexable
 * HTML, the same articles as the classic page (EntryArticle). Plus the keyboard list that
 * drives the same navigation as the clicks.
 */
import EntryArticle from './EntryArticle.astro';
import { loadSections, type Entry } from '../content/sections';
import { normalizeText } from '../system/search';

const sections = await loadSections();
/** What the map's search looks in, normalised once here (accents, case). */
/** Titles shown over the bodies with the I key: projects and experiences (not the moons). */
const titled = sections.entries.filter((e) => e.data.category !== 'skill');
const searchText = (e: Entry) =>
  normalizeText([e.data.title, e.data.summary, ...e.data.tags].join(' '));
---

<section id="system-ui" class="system-ui" aria-label="Système planétaire du portfolio" hidden>
  <button
    type="button"
    class="map-open"
    data-map-toggle
    aria-controls="system-map"
    aria-expanded="true"
    hidden
  >
    Carte <kbd>M</kbd>
  </button>
  <aside id="system-map" class="system-map" aria-labelledby="system-map-title" data-open="true">
    <header class="map-head">
      <h2 id="system-map-title">Carte du système</h2>
      <button type="button" class="map-close" data-map-toggle aria-label="Fermer la carte">
        ×
      </button>
    </header>
    <label class="map-search">
      <span class="sr-only">Rechercher un projet, une compétence…</span>
      <input
        type="search"
        data-map-search
        placeholder="Rechercher : Rust, SOC, autonomie…"
        autocomplete="off"
        spellcheck="false"
      />
    </label>
    <p class="map-empty" data-map-empty hidden>
      Aucun résultat.
    </p>
    <nav class="system-nav" aria-label="Aller vers un astre">
      {sections.groups.map((g) => (
        <div class="system-nav-group" data-map-group>
          <h3>{g.title}</h3>
          <ul>
            {g.items.map((e) => (
              <li data-search={searchText(e)} data-slug={e.id}>
                <a href={`#${e.id}`} data-body={e.id}>
                  {e.data.title}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </nav>
    <p class="map-hint">
      <kbd>M</kbd> carte ·
      <button type="button" class="titles-toggle" data-titles-toggle aria-pressed="false">
        <kbd>I</kbd> titres
      </button>
      · <kbd>Échap</kbd> retour
    </p>
  </aside>
  <div id="body-titles" class="body-titles" hidden>
    {titled.map((e) => (
      <a class="body-title" href={`#${e.id}`} data-body={e.id} data-title-of={e.id}>
        {e.data.title}
      </a>
    ))}
  </div>
  <a class="system-classic" href="/classique/">
    Version classique
  </a>

  {sections.entries.map((e) => (
    <EntryArticle entry={e} sections={sections} variant="panel" />
  ))}
</section>

<style>
  .system-ui {
    position: fixed;
    inset: 0;
    z-index: 6;
    pointer-events: none;
    color: var(--ink);
    font:
      400 0.95rem/1.55 system-ui,
      sans-serif;
  }

  /* The system map: every body, grouped, with a search (open at first, closable). */
  .system-map {
    position: absolute;
    left: 1rem;
    top: 1rem;
    display: flex;
    flex-direction: column;
    width: min(18rem, calc(100% - 2rem));
    max-height: calc(100% - 4.5rem);
    padding: 0.9rem 1rem 0.75rem;
    background: rgb(2 4 12 / 0.78);
    border-left: 2px solid #2f6bff;
    backdrop-filter: blur(8px);
    pointer-events: auto;
  }
  .system-map[data-open='false'] {
    display: none;
  }
  .map-open {
    position: absolute;
    left: 1rem;
    top: 1rem;
    padding: 0.45rem 0.9rem;
    font: inherit;
    font-size: 0.85rem;
    color: var(--ink);
    background: rgb(2 4 12 / 0.7);
    border: 1px solid rgb(180 224 255 / 0.35);
    cursor: pointer;
    pointer-events: auto;
  }
  .map-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .map-head h2 {
    margin: 0;
    font-size: 0.8rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #b4e0ff;
  }
  .map-close {
    width: 1.8rem;
    height: 1.8rem;
    font-size: 1.2rem;
    line-height: 1;
    color: var(--ink);
    background: transparent;
    border: 0;
    cursor: pointer;
  }
  .map-search input {
    box-sizing: border-box;
    width: 100%;
    margin: 0.6rem 0 0.4rem;
    padding: 0.5rem 0.65rem;
    font: inherit;
    font-size: 0.9rem;
    color: var(--ink);
    background: rgb(255 255 255 / 0.06);
    border: 1px solid rgb(180 224 255 / 0.3);
    border-radius: 0;
  }
  .map-search input:focus-visible {
    outline: 1px solid #2f6bff;
    border-color: #2f6bff;
  }
  .map-empty {
    margin: 0.4rem 0;
    opacity: 0.7;
  }
  .system-nav {
    overflow: auto;
    overscroll-behavior: contain;
  }
  .system-nav h3 {
    margin: 0.7rem 0 0.2rem;
    font-size: 0.72rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    opacity: 0.6;
  }
  .system-nav ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .system-nav a {
    display: block;
    padding: 0.2rem 0.4rem;
    color: inherit;
    text-decoration: none;
  }
  .system-nav a:hover,
  .system-nav a:focus-visible {
    background: rgb(47 107 255 / 0.22);
    outline: none;
  }
  .map-hint {
    margin: 0.6rem 0 0;
    font-size: 0.75rem;
    opacity: 0.55;
  }
  .titles-toggle {
    padding: 0;
    font: inherit;
    color: inherit;
    background: none;
    border: 0;
    text-decoration: underline dotted;
    cursor: pointer;
  }
  .titles-toggle[aria-pressed='true'] {
    color: #b4e0ff;
  }
  /* Title cards over the bodies (I): placed every frame by the 3D side (CSSOM). */
  .body-titles {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .body-title {
    position: absolute;
    left: 0;
    top: 0;
    padding: 0.2rem 0.5rem;
    font-size: 0.78rem;
    line-height: 1.2;
    white-space: nowrap;
    color: var(--ink);
    text-decoration: none;
    background: rgb(2 4 12 / 0.7);
    border-left: 2px solid #2f6bff;
    pointer-events: auto;
    will-change: transform;
    /* Centred above the body's screen point (the transform, set every frame). */
    translate: -50% calc(-100% - 0.7rem);
  }
  .body-title[hidden] {
    display: none;
  }
  .body-title:hover,
  .body-title:focus-visible {
    background: rgb(47 107 255 / 0.35);
    outline: none;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  kbd {
    font: inherit;
    font-size: 0.75em;
    opacity: 0.7;
  }
  /* Touch: entries and buttons big enough for a finger (44 px). */
  @media (pointer: coarse) {
    .system-nav a {
      padding-block: 0.6rem;
    }
    .map-close {
      width: 2.75rem;
      height: 2.75rem;
    }
    .map-open {
      min-height: 2.75rem;
      padding-inline: 1.1rem;
    }
  }
  .system-classic {
    position: absolute;
    right: 1.25rem;
    bottom: 1rem;
    font-size: 0.85rem;
    color: var(--ink);
    opacity: 0.6;
    pointer-events: auto;
  }
  .system-classic:hover,
  .system-classic:focus-visible {
    opacity: 1;
  }
</style>
