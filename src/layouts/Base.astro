---
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const buildSha = import.meta.env.PUBLIC_BUILD_SHA ?? 'dev';
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <meta name="x-build" content={buildSha} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --forge-void: #050302;
    --ink: #e8e2dc;
  }

  html,
  body {
    margin: 0;
    height: 100%;
    background: var(--forge-void);
    color: var(--ink);
  }
</style>
